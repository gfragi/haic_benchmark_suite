# ---- Builder stage ----
FROM node:20-alpine AS builder

WORKDIR /app

# Native build support for packages compiled via node-gyp.
RUN apk add --no-cache python3 make g++

ENV PYTHON=/usr/bin/python3

# Install dependencies first for better layer caching.
COPY frontend-react/package.json frontend-react/package-lock.json ./
RUN npm ci

# Copy the React frontend source from the repo root context.
COPY frontend-react/ ./

RUN npm run build

# ---- Runtime stage ----
FROM nginx:alpine

# Templated (not copied straight to conf.d) so the entrypoint's envsubst
# step can resolve ${NGINX_LOCAL_RESOLVERS} - see comment in k8s/nginx.conf.
RUN rm /etc/nginx/conf.d/default.conf
COPY k8s/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=builder /app/dist /usr/share/nginx/html

ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
